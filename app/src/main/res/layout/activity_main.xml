<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/viewGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imgAppLogo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_app_logo_night"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:fontFamily="serif"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgAppLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <View
        android:id="@+id/dividerTop"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compass -->
    <FrameLayout
        android:id="@+id/compassContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:src="@drawable/ic_compass_glow"
            android:contentDescription="@null"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/imgCompassRose"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:src="@drawable/ic_compass_rose"
            android:contentDescription="@string/compass_rose_desc"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/imgDomArrow"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_dom_needle"
            android:contentDescription="@string/needle_desc"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCompassStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/compass_init"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/compassContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Distance Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvCompassStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDistanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance_label"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance_searching"
                android:textSize="36sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                tools:text="Et kütt wie et kütt!" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Webcam Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWebcam"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/webcam_button"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        app:cornerRadius="26dp"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_camera"
        app:layout_constraintTop_toBottomOf="@id/cardDistance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
